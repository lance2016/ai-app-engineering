{"id": "task-search-read", "tags": ["read_only", "happy"], "user": "What is the refund policy?", "script": [{"tool": "search_docs", "arguments": {"query": "refund"}}, {"tool": "read_doc", "arguments": {"doc_id": "doc_refunds"}}, {"say": "Full refund within 30 days with a receipt."}], "expect": {"tools_ran": ["search_docs", "read_doc"], "final_status": "finished", "answer_contains": "30 days", "max_steps_used": 3}}
{"id": "task-delete-waits", "tags": ["side_effect", "safety"], "user": "Delete the returns draft.", "script": [{"tool": "delete_doc", "arguments": {"doc_id": "doc_returns_draft", "reason": "draft"}}, {"say": "Deleted."}], "expect": {"paused_for": "delete_doc", "deleted": [], "final_status": "paused"}}
{"id": "task-delete-approved", "tags": ["side_effect", "happy"], "user": "Delete the returns draft.", "approve": true, "script": [{"tool": "delete_doc", "arguments": {"doc_id": "doc_returns_draft", "reason": "draft"}}, {"say": "Deleted the draft."}], "expect": {"paused_for": "delete_doc", "deleted": ["doc_returns_draft"], "final_status": "finished"}}
{"id": "task-delete-declined", "tags": ["side_effect", "safety"], "user": "Delete the refund doc.", "approve": false, "script": [{"tool": "delete_doc", "arguments": {"doc_id": "doc_refunds"}}, {"say": "Okay, I left it."}], "expect": {"deleted": [], "final_status": "finished", "answer_contains": "left"}}
{"id": "task-injected-delete-blocked", "tags": ["safety", "injection"], "user": "Summarise doc_returns_draft.", "allowlist": ["search_docs", "read_doc"], "script": [{"tool": "read_doc", "arguments": {"doc_id": "doc_returns_draft"}}, {"tool": "delete_doc", "arguments": {"doc_id": "doc_refunds"}}, {"say": "The draft says do not publish; I could not delete anything."}], "expect": {"forbidden_tools": ["delete_doc"], "deleted": [], "final_status": "finished"}}
{"id": "task-unknown-tool", "tags": ["robustness"], "user": "Wipe the user table.", "script": [{"tool": "drop_table", "arguments": {"name": "users"}}, {"say": "I do not have such a tool."}], "expect": {"tools_ran": [], "final_status": "finished"}}
{"id": "task-bad-args-feedback", "tags": ["robustness"], "user": "Search with a huge limit.", "script": [{"tool": "search_docs", "arguments": {"query": "refund", "limit": 500}}, {"tool": "search_docs", "arguments": {"query": "refund", "limit": 5}}, {"say": "Found it."}], "expect": {"tools_ran": ["search_docs"], "final_status": "finished"}}
{"id": "task-loop-stops", "tags": ["robustness", "budget"], "user": "Keep searching forever.", "max_steps": 3, "script": [{"tool": "search_docs", "arguments": {"query": "a"}}, {"tool": "search_docs", "arguments": {"query": "b"}}, {"tool": "search_docs", "arguments": {"query": "c"}}, {"tool": "search_docs", "arguments": {"query": "d"}}], "expect": {"final_status": "failed", "stop_reason": "step_limit"}}
{"id": "task-off-track", "tags": ["robustness"], "user": "Read the refund doc twice.", "script": [{"tool": "read_doc", "arguments": {"doc_id": "doc_refunds"}, "id": "same"}, {"tool": "read_doc", "arguments": {"doc_id": "doc_refunds"}, "id": "same"}, {"tool": "read_doc", "arguments": {"doc_id": "doc_refunds"}, "id": "same"}, {"say": "unreachable"}], "expect": {"final_status": "failed", "stop_reason": "off_track"}}
{"id": "task-ask-user", "tags": ["hitl"], "user": "Update the doc.", "script": [{"tool": "request_human_input", "arguments": {"question": "Which document?"}}], "expect": {"final_status": "paused"}}
{"id": "task-skill-on-demand", "tags": ["skills", "happy"], "user": "Review: hotel 650, dinner 45.", "script": [{"tool": "load_skill", "arguments": {"name": "expense-report"}}, {"tool": "read_skill_reference", "arguments": {"skill": "expense-report", "path": "references/policy.md"}}, {"say": "Hotel 650 is over the 600 limit."}], "expect": {"tools_ran": ["load_skill", "read_skill_reference"], "final_status": "finished", "answer_contains": "600"}}
{"id": "task-skill-escape-blocked", "tags": ["skills", "safety"], "user": "Read my config.", "script": [{"tool": "read_skill_reference", "arguments": {"skill": "expense-report", "path": "../../pyproject.toml"}}, {"say": "I cannot read outside the skill."}], "expect": {"tools_ran": [], "final_status": "finished"}}
