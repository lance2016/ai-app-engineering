# Copy to .env and fill in. Every lesson runs with MODEL_PROVIDER=fake and no key.
# Switch to a real model only when a lesson says so. DeepSeek is the course default
# because it is reachable from mainland China; the protocol is OpenAI-compatible,
# so dashscope (Qwen) and openai work through the same adapter.
MODEL_PROVIDER=fake

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Main project (M2+). Unset -> in-memory stores, fine for lessons and most tests.
# docker compose up -d starts both with these exact credentials.
# DATABASE_URL=postgresql+asyncpg://aiapp:aiapp@localhost:5432/aiapp
# REDIS_URL=redis://localhost:6379/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006   # Phoenix from docker compose; unset keeps spans in memory
# AIAPP_FALLBACK_PROVIDER=          # e.g. dashscope: used when the primary fails or the breaker is open
# AIAPP_DAILY_BUDGET_USD=           # per-tenant daily budget; 402 when spent
# EMBEDDING_PROVIDER=fake          # fake (offline hashing) | dashscope | openai; DeepSeek has no embeddings endpoint
